// rec.js — « Capture IQ » du dashboard : découpe une TRANCHE par OFFSETS dans
// l'enregistrement continu du pont (AIRREC), et génère les commandes.
//
// [2026-08-16] Deuxième réécriture. La première découpait par SEGMENTS via
// SIGUSR1 ; l'opérateur ne veut pas d'un cfile en morceaux, et il a raison : un
// fichier coupé oblige à concaténer avant toute analyse. AIRREC écrit désormais
// UN SEUL fichier continu par sens et par run, sur DISQUE (/root/osmo-rec) et
// non plus en RAM — l'overlay a 295 Go libres là où /dev/shm en avait 6,7 et
// portait aussi les journaux.
//
// On ne copie donc plus rien et on ne coupe plus rien : on relève la TAILLE du
// fichier au start et au stop. La différence est la tranche, et `dd` l'extrait
// exactement. Aucune donnée n'est dupliquée pendant l'enregistrement.
//
// ⚠️ CE N'EST PAS UNE CAPTURE D'AIR — l'I/Q d'AIRREC est RECONSTRUITE à partir
// des bits : ni bruit, ni ToA réelle, ni fading. Rejeu fidèle aux BITS.
const fs   = require('fs');
const path = require('path');
const { execFileSync } = require('child_process');

const AIR_DIR   = process.env.PONT_AIRREC_DIR || '/root/osmo-rec';
// ⚠️ Ancrés sur 14 chiffres : 'air_pont_' est un PRÉFIXE de 'air_pont_ul_', un
// simple startsWith ferait passer le montant pour du descendant.
const SEG_RE    = /^air_pont_\d{14}\.cfile$/;
const SEG_UL_RE = /^air_pont_ul_\d{14}\.cfile$/;
const SAMP      = 1083333;
const BPS       = 8;                         // complex64 = 8 octets/échantillon
const CONTAINER = process.env.PONT_CONTAINER || 'osmo-operator-1';
const KC_PATH   = '/dev/shm/calypso_kc';     // [4]algo [6..13]Kc(8)

const MODES = ['BCCH', 'BCCH_SDCCH4', 'SDCCH8', 'TCHF', 'TCHH'];
// AIRREC enregistre les 8 timeslots dans le MÊME fichier : la « source » ne
// choisit plus une fifo, seulement les défauts de -m / -t / -a.
const SOURCES = {
  sdcch: { m: 'BCCH_SDCCH4', t: 0, a: 514 },
  tch:   { m: 'TCHF',        t: 2, a: 514, d: 'FR' },
};

let cur = null;

function fichierCourant(re) {
  try {
    const l = fs.readdirSync(AIR_DIR).filter(function (f) { return re.test(f); }).sort();
    return l.length ? path.join(AIR_DIR, l[l.length - 1]) : null;
  } catch (e) { return null; }
}
function taille(p) { try { return p ? fs.statSync(p).size : 0; } catch (e) { return 0; } }
function align8(n) { return n - (n % BPS); }

function pontPid() {
  try {
    const out = execFileSync('pgrep', ['-f', 'pont\\.py$']).toString().split('\n')[0].trim();
    return out ? parseInt(out, 10) : 0;
  } catch (e) { return 0; }
}

function readKc(getLastKc) {
  function pack(bytes) {
    // Deux formes : espacée pour l'affichage, COMPACTE pour la ligne de commande.
    // grgsm accepte '1234567890ABCDEF' comme '0x12,0x34,...' ; l'opérateur veut
    // pouvoir copier-coller sans avoir à retirer les espaces à la main.
    const hex = Array.from(bytes).map(function (x) { return x.toString(16).padStart(2, '0'); });
    return { spaced: hex.join(' '), compact: hex.join('') };
  }
  try {
    const b = fs.readFileSync(KC_PATH);
    if (b.length >= 14) {
      const algo = b[4];
      const kc = b.slice(6, 14);
      if (algo !== 0 && !kc.every(function (x) { return x === 0; })) {
        const f = pack(kc);
        return { present: true, algo: algo, spaced: f.spaced, compact: f.compact, fromCache: false, ageMs: 0 };
      }
    }
  } catch (e) {}
  const last = getLastKc && getLastKc();
  if (last) return { present: true, algo: last.algo, spaced: last.spaced,
                     compact: String(last.spaced).replace(/\s+/g, ''),
                     fromCache: true, ageMs: Date.now() - last.tsMs };
  return { present: false, algo: 0, spaced: '', compact: '' };
}

function buildCmds(cfg, file, kc, m, t) {
  const isTch = /^TCH/.test(m);
  const base = 'grgsm_decode -m ' + m + ' -t ' + t + ' -a ' + cfg.a + ' -s ' + SAMP +
               (isTch ? ' -d FR' : '') + ' -c ' + path.basename(file) + ' -v';
  return {
    ciphered:   base + ' -p',
    deciphered: kc.present ? (base + ' -e ' + kc.algo + ' -k ' + kc.compact)
                           : (base + '   # Kc absent : lance une session chiffrée puis re-record'),
  };
}

function sanitizeKc(str) {
  if (!str) return '';
  var m = String(str).match(/[0-9a-fA-F]{2}/g);
  if (!m || m.length < 8) return '';
  return m.slice(0, 8).map(function (b) { return b.toLowerCase(); }).join('');
}

module.exports = function (deps) {
  const broadcast = deps.broadcast;
  const log = deps.log || function () {};
  const getLastKc = deps.getLastKc || function () { return null; };

  function status() {
    if (!cur) return { running: false };
    return { running: true, source: cur.source,
             bytes: Math.max(0, taille(cur.dlFile) - cur.dlStart),
             seconds: Math.round((Date.now() - cur.startMs) / 1000),
             path: cur.dlFile };
  }
  function bcastStatus() { broadcast({ type: 'rec_status', data: status() }); }

  function fail(ws, msg) {
    if (ws) ws.send(JSON.stringify({ type: 'rec_error', data: { msg: msg }, ts: Date.now() }));
    log('rec ERREUR : ' + msg);
  }

  function start(source, opts, ws) {
    opts = opts || {};
    if (cur) { fail(ws, 'enregistrement déjà en cours'); return; }
    const cfg = SOURCES[source] || SOURCES.sdcch;

    // On DIT pourquoi ça ne peut pas marcher, au lieu de rendre un fichier vide.
    if (!pontPid()) { fail(ws, 'pont.py absent : rien n\'enregistre. Lance la pile en CALYPSO_BRIDGE=pont.'); return; }
    const dlFile = fichierCourant(SEG_RE);
    if (!dlFile) {
      fail(ws, 'aucun fichier air_pont_* dans ' + AIR_DIR + ' : AIRREC est coupé (PONT_AIRREC=0), '
             + 'ou le disque est plein — voir /dev/shm/pont.log');
      return;
    }
    const ulFile = fichierCourant(SEG_UL_RE);
    var m = (MODES.indexOf(opts.m) >= 0) ? opts.m : cfg.m;
    var t = (opts.t != null && opts.t >= 0 && opts.t <= 7) ? (opts.t | 0) : cfg.t;
    cur = { source: source, cfg: cfg, m: m, t: t, kcManual: sanitizeKc(opts.kc),
            startMs: Date.now(),
            dlFile: dlFile, dlStart: align8(taille(dlFile)),
            ulFile: ulFile, ulStart: align8(taille(ulFile)) };
    cur.timer = setInterval(bcastStatus, 1000);
    log('rec start : offset DL ' + cur.dlStart + ' dans ' + path.basename(dlFile));
    bcastStatus();
  }

  function tranche(file, start, end, sens, stamp) {
    if (!file || end <= start) return null;
    const len = align8(end - start);
    if (len <= 0) return null;
    const out = path.join(AIR_DIR, 'slice_' + sens + '_' + stamp + '.cfile');
    return {
      src: file, start: start, len: len, out: out,
      seconds: +(len / BPS / SAMP).toFixed(1),
      // UNE SEULE COMMANDE, LANCEE DEPUIS L'HOTE.
      // La version precedente donnait un `dd` nu suivi d'un `docker cp` : le dd
      // avait l'air lancable depuis l'hote alors que le fichier vit DANS le
      // conteneur (« dd: impossible d'ouvrir … Aucun fichier ou dossier de ce
      // nom »), et le docker cp qui suivait ne trouvait donc rien non plus.
      // On passe par `docker exec` et on redirige la sortie standard : la
      // tranche atterrit directement dans le repertoire courant de l'HOTE, sans
      // fichier intermediaire dans le conteneur (qui aurait double la place
      // occupee). `status=progress` ecrit sur stderr, il reste donc visible.
      // bs=8M + iflag=*_bytes : sans iflag, `skip` compterait en BLOCS de 8 Mo
      // et la tranche serait extraite tres loin de sa position.
      dd: 'docker exec ' + CONTAINER + ' dd if=' + file
        + ' bs=8M iflag=skip_bytes,count_bytes skip=' + start + ' count=' + len
        + ' status=progress > ' + path.basename(out),
      cp: '',
    };
  }

  function stop(ws, note) {
    if (!cur) { if (ws) ws.send(JSON.stringify({ type: 'rec_status', data: { running: false }, ts: Date.now() })); return; }
    const c = cur; cur = null;
    clearInterval(c.timer);
    const stamp = new Date().toISOString().replace(/[-:T]/g, '').slice(0, 14);
    const dl = tranche(c.dlFile, c.dlStart, align8(taille(c.dlFile)), 'dl', stamp);
    // MONTANT RETIRE DES SUGGESTIONS. Proposer une commande grgsm sur une capture
    // montante etait un piege : l'outil ne sait pas la decoder (il se cale sur
    // FCCH/SCH, descendants). Le montant s'observe par le TAP GSMTAP du pont,
    // en L2 deja decodee — port 4729 par defaut.
    const ul = null;

    const kc = c.kcManual
      ? { present: true, algo: 1, spaced: c.kcManual, compact: c.kcManual, fromCache: false, ageMs: 0, manual: true }
      : readKc(getLastKc);
    const cmds   = dl ? buildCmds(c.cfg, dl.out, kc, c.m, c.t) : { ciphered: '', deciphered: '' };
    const cmdsUl = ul ? buildCmds(c.cfg, ul.out, kc, c.m, c.t) : { ciphered: '', deciphered: '' };

    broadcast({ type: 'rec_result', data: {
      path: dl ? dl.out : '(rien enregistré)', bytes: dl ? dl.len : 0,
      seconds: dl ? dl.seconds : 0,
      srcFile: dl ? dl.src : '', offset: dl ? dl.start : 0,
      ddCmd: dl ? dl.dd : '', cpCmd: dl ? dl.cp : '',
      pathUl: ul ? ul.out : '', bytesUl: ul ? ul.len : 0,
      ddCmdUl: ul ? ul.dd : '', cpCmdUl: ul ? ul.cp : '',
      source: c.source, mode: c.m, timeslot: c.t,
      kcPresent: kc.present, kcAlgo: kc.algo, kc: kc.compact,
      kcFromCache: kc.fromCache || false, kcAgeMs: kc.ageMs || 0, kcManual: kc.manual || false,
      cmdCiphered: cmds.ciphered, cmdDeciphered: cmds.deciphered,
      cmdUlCiphered: cmdsUl.ciphered, cmdUlDeciphered: cmdsUl.deciphered,
      note: note || '',
      hint: '① extraire la tranche (une commande, depuis l\'HÔTE : elle sort le fichier du conteneur) ② décoder. '
          + 'Le cfile ne porte que le DESCENDANT (le SMS MT y est). Pour le MONTANT — donc le SMS MO — regarde le tap GSMTAP du pont sur udp/4729 : aucun outil ne sait démoduler un enregistrement montant. '
          + '⚠️ I/Q RECONSTRUITE à partir des bits (ni bruit, ni ToA réelle, ni fading) : rejeu fidèle aux BITS, pas une capture d\'air. '
          + 'Une seule instance de grgsm_decode à la fois (elle bind UDP 4729).',
    } });
    bcastStatus();
    log('rec stop : DL ' + (dl ? dl.len : 0) + ' o, UL ' + (ul ? ul.len : 0) + ' o');
  }

  return { start: start, stop: stop, status: status };
};
