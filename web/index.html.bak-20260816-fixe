// ═══ WebSocket ═══
// [2026-08-08] Schema ET hote derives de la page.
// L'ancienne forme cablait `ws://` et un port de repli 80. Servie en https://,
// la page se voyait alors refuser la WebSocket par le navigateur (contenu
// mixte : ws:// en clair depuis une origine sure), et le repli l'envoyait en
// plus sur le port 80 puisque location.port est VIDE sur le 443 implicite.
// Resultat : aucune WebSocket, donc ni tshark, ni VTY, ni etat live — et rien
// ne le disait, le bouton restait simplement « off ».
// location.host inclut deja le port quand il n'est pas celui par defaut.
const WS_URL = `${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}`;
let ws = null;
let opState = {}, activeOpIds = [];
let reconnectDelay = 1000;
let captureRunning = false;   // état réel de la capture (piloté par tshark_status)

function connectWs() {
  ws = new WebSocket(WS_URL);
  ws.binaryType = 'arraybuffer';
  ws.onopen = () => { setWs(true); reconnectDelay = 1000; };
  ws.onmessage = e => {
    handle(JSON.parse(e.data));
  };
  ws.onclose = () => { setWs(false); setTimeout(connectWs, reconnectDelay); reconnectDelay = Math.min(reconnectDelay*1.5, 10000); };
  ws.onerror = () => {};
}
function setWs(on) {
  document.getElementById('ws-dot').className = 'dot '+(on?'on':'off');
  document.getElementById('ws-txt').textContent = on?'LIVE':'…';
}
function send(msg) { if (ws && ws.readyState===1) ws.send(JSON.stringify(msg)); }

// ═══ Message Router ═══
function handle(msg) {
  switch(msg.type) {
    case 'rec_status': onRecStatus(msg.data); break;
    case 'rec_result': onRecResult(msg.data); break;
    case 'rec_error':  setRec(false); alert('Capture IQ: ' + (msg.data && msg.data.msg)); break;
    case 'init':
      activeOpIds = msg.data.activeOpIds||[];
      updateOps(msg.data.operators);
      setCaptureRunning(msg.data.tsharkActive || false);
      if(msg.data.a5) updateA5(msg.data.a5);
      break;
    case 'state':
      activeOpIds = msg.data.activeOpIds||activeOpIds;
      updateOps(msg.data.operators);
      break;
    case 'a5_status': updateA5(msg.data); break;
    case 'tshark_status':
      setCaptureRunning(msg.data.active);
      break;
    case 'packet': addPacket(msg.data); break;
    case 'tshark_stopped':
      setCaptureRunning(false);
      break;
    case 'tshark_error':
      setCaptureRunning(false);
      document.getElementById('tag-tshark').textContent='tshark ERR';
      break;
    case 'packet_hex':
      onPacketHex(msg.data);
      break;
    case 'packet_dissect':
      onPacketDissect(msg.data);
      break;
    case 'vty_connected': vtyOnConnected(msg.data); break;
    case 'vty_data': vtyOnData(msg.data); break;
    case 'vty_error': vtyOnError(msg.data); break;
    case 'vty_disconnected': vtyOnDisc(msg.data); break;
    case 'mic_state': micOnServerState(msg.data); break;
    case 'mic_stat':  micOnServerStat(msg.data); break;
  }
}

function setCaptureRunning(on) {
  captureRunning = on;
  setTsharkTag(on);
}

function setTsharkTag(on) {
  const el = document.getElementById('tag-tshark');
  el.textContent = on ? 'tshark ●' : 'tshark off';
  el.className = 'htag' + (on?' on':'');
}

