    </div>
    <div id="${wid}-decode" class="pkt-popup-body pkt-popup-decode" style="padding:8px 10px;font-family:'Fira Code',monospace;font-size:11px;line-height:1.8">
      <span style="color:var(--t3)">Chargement dissection…</span>
    </div>
    <div id="${wid}-hex" class="pkt-popup-body hex-dump" style="display:none"></div>
    <div id="${wid}-raw" class="pkt-popup-body hex-dump" style="display:none"></div>`;

  layer.appendChild(div);
  document.querySelectorAll('.vty-popup').forEach(pp => pp.style.zIndex = 200);
  div.style.zIndex = 210;

  // Decode — utilise les layers déjà présents ou demande au serveur (une seule fois)
  const decodeEl = document.getElementById(wid + '-decode');
  if (p.layers) {
    renderDecodeInto(p, decodeEl);
  } else if (p.frameNum && !p._pendingDissect) {
    p._pendingDissect = true;
    send({ type: 'packet_dissect_request', frameNum: p.frameNum });
  }

  // Hex
  const hexEl = document.getElementById(wid + '-hex');
  if (p.hexDump) {
    _renderHex(hexEl, p.hexDump);
  } else if (p.frameNum) {
    hexEl.setAttribute('data-frame-num', p.frameNum);
    send({ type: 'packet_hex_request', frameNum: p.frameNum });
  }

  // Raw JSON
  const c = Object.assign({}, p); delete c.hexDump;
  document.getElementById(wid + '-raw').textContent = JSON.stringify(c, null, 2);
}

function pktPopTab(wid, tab, btn) {
  ['decode','hex','raw'].forEach(t => {
    const el = document.getElementById(wid + '-' + t);
    if (el) el.style.display = t === tab ? 'block' : 'none';
  });
  const tabsEl = document.querySelector('#' + wid + ' .detail-tabs-pop');
  if (tabsEl) tabsEl.querySelectorAll('button').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}

// ═══ VTY Popup Windows ═══
let vtyCounter = 0;
const vtyWindows = {};

function spawnVty() {
  vtyCounter++;
  const wid = 'vty-'+vtyCounter;
  const layer = document.getElementById('vty-layer');

  // Stagger position
  const offset = (vtyCounter-1) * 30;
  const top = 80 + (offset % 200);
  const left = 200 + (offset % 300);

  const div = document.createElement('div');
  div.className = 'vty-popup';
  div.id = wid;
  div.style.top = top+'px';
  div.style.left = left+'px';
  div.innerHTML = `
    <div class="vty-popup-header" onmousedown="startDrag(event,'${wid}')">
      <span class="title">VTY #${vtyCounter}</span>
      <select class="vty-op-sel" data-wid="${wid}"><option value="">OP…</option></select>
      <select class="vty-comp-sel" data-wid="${wid}">
        <option value="bsc">BSC</option><option value="msc">MSC</option><option value="hlr">HLR</option>
        <option value="bts">BTS</option><option value="mgw">MGW</option><option value="stp">STP</option>
        <option value="sgsn">SGSN</option><option value="ggsn">GGSN</option><option value="pcu">PCU</option>
        <option value="bb1">BB MS1 ☎ 4247</option>
        <option value="bb2">BB MS2 ☎ 4248</option>
      </select>
      <button class="btn primary" style="padding:3px 10px;font-size:11px" onclick="vtyPopConnect('${wid}')">Go</button>
      <button class="close-btn" onclick="vtyPopClose('${wid}')">✕</button>
    </div>
    <div class="vty-screen" id="${wid}-screen" style="display:none"></div>
    <div style="display:flex;align-items:center;justify-content:center;flex:1;color:var(--t3);font-size:12px;background:var(--term-bg)" id="${wid}-empty">Select OP + component → Go</div>
    <div class="vty-input-row">
      <span class="prm" id="${wid}-prm">$</span>
      <input type="text" placeholder="VTY command…" onkeydown="vtyPopKey(event,'${wid}')" autocomplete="off" spellcheck="false">
    </div>`;
  layer.appendChild(div);

  vtyWindows[wid] = { key:null, buffer:'', history:[], histIdx:-1 };
  updateVtySelects();
}

function vtyPopConnect(wid) {
  const popup = document.getElementById(wid);
  const opId = popup.querySelector('.vty-op-sel').value;
  const comp = popup.querySelector('.vty-comp-sel').value;
  if (!opId) return;
  const key = `${opId}-${comp}`;
  vtyWindows[wid].key = key;
  vtyWindows[wid].buffer = '';
  send({ type:'vty_connect', opId:parseInt(opId), component:comp });
}

function vtyPopClose(wid) {
  const w = vtyWindows[wid];
  if (w && w.key) send({ type:'vty_disconnect', key:w.key });
  delete vtyWindows[wid];
  const el = document.getElementById(wid);
  if (el) el.remove();
}

function vtyPopKey(e, wid) {
  const input = e.target;
  const w = vtyWindows[wid];
  if (!w) return;
  if (e.key==='Enter') {
    const cmd = input.value;
    if (!w.key) return;
    w.tab = null;
    w.buffer += `\x1b[cmd]${cmd}\x1b[/]\r\n`;
    w.history.push(cmd); w.histIdx = w.history.length;
    send({ type:'vty_exec', key:w.key, cmd });
    input.value = '';
    renderVtyPop(wid);
  } else if (e.key==='ArrowUp') {
    e.preventDefault();
    if (w.histIdx>0) { w.histIdx--; input.value=w.history[w.histIdx]||''; }
  } else if (e.key==='ArrowDown') {
    e.preventDefault();
    if (w.histIdx<w.history.length-1) { w.histIdx++; input.value=w.history[w.histIdx]||''; }
    else { w.histIdx=w.history.length; input.value=''; }
  } else if (e.key==='?') {
    // aide osmocom : liste les options possibles (serveur envoie 'partial?')
    e.preventDefault();
    w.tab = null;
    if (w.key) send({ type:'vty_complete', key:w.key, partial:input.value });
  } else if (e.key==='Tab') {
    // complétion : même listing osmocom, puis on complète le mot côté client
    e.preventDefault();
    if (w.key) { w.tab = { partial: input.value }; send({ type:'vty_complete', key:w.key, partial:input.value }); }
  }
}

// Complétion Tab : parse le listing osmocom renvoyé après 'partial?' et complète
// le dernier mot jusqu'au plus long préfixe commun (transport telnet ligne : pas
// de complétion char-level native, on la reconstruit côté client). Sans candidat
// fiable on ne touche pas l'input → au pire le listing s'affiche comme pour '?'.
function vtyTabComplete(wid, added) {
  const w = vtyWindows[wid];
  if (!w || !w.tab) return;
  const partial = w.tab.partial; w.tab = null;
  const cands = [];
  added.split(/\r?\n/).forEach(function(ln){
    const t = ln.replace(/\x1b\[[^m]*m/g,'').trim();
    if (!t || t[0]==='%') return;
    const first = t.split(/\s+/)[0];
    if (/^[A-Za-z0-9_.\-]+$/.test(first)) cands.push(first);   // token simple (pas prompt/<range>)
  });
  if (!cands.length) return;
  const parts = partial.split(/\s+/);
  const lastWord = parts[parts.length-1];
  let matching = cands.filter(function(c){ return c.indexOf(lastWord)===0; });
  if (!matching.length) return;
  const lcp = matching.reduce(function(a,b){ let i=0; while(i<a.length&&i<b.length&&a[i]===b[i]) i++; return a.slice(0,i); });
  const input = document.querySelector('#'+wid+' .vty-input-row input');
  if (!input) return;
  if (lcp.length > lastWord.length || (matching.length===1 && lcp===lastWord)) {
    parts[parts.length-1] = lcp;
    input.value = parts.join(' ') + (matching.length===1 ? ' ' : '');
    input.focus();
  }
}

function renderVtyPop(wid) {
  const w = vtyWindows[wid];
  if (!w) return;
  const screen = document.getElementById(wid+'-screen');
  if (!screen) return;
  screen.innerHTML = w.buffer
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/\x1b\[sys\](.*?)\x1b\[\/\]/gs, '<span class="sys">$1</span>')
    .replace(/\x1b\[err\](.*?)\x1b\[\/\]/gs, '<span class="err">$1</span>')
    .replace(/\x1b\[cmd\](.*?)\x1b\[\/\]/gs, '<span class="cmd">$1</span>');
  screen.scrollTop = screen.scrollHeight;
}

function findVtyWid(key) {
  for (const [wid, w] of Object.entries(vtyWindows)) {
    if (w.key === key) return wid;
  }
  return null;
}

function vtyOnConnected(d) {
  let wid = findVtyWid(d.key);
  if (!wid) {
    // Find a window without a key
    for (const [w, state] of Object.entries(vtyWindows)) {
      if (!state.key) { state.key = d.key; state.buffer = ''; wid = w; break; }
    }
    if (!wid) return;
  }
  const w = vtyWindows[wid];
  const retryNote = d.retry > 0 ? ` (retry ${d.retry})` : '';
  w.buffer += `\x1b[sys]Connected to op${d.opId}/${d.component}:${d.port}${retryNote}\x1b[/]\r\n`;
  document.getElementById(wid+'-empty').style.display='none';
  document.getElementById(wid+'-screen').style.display='block';
  document.getElementById(wid+'-prm').textContent = `op${d.opId}/${d.component}> `;
  const title = document.querySelector(`#${wid} .title`);
  if (title) title.textContent = `VTY op${d.opId}/${d.component}`;
  renderVtyPop(wid);
}

function vtyOnData(d) {
  const wid = findVtyWid(d.key);
  if (!wid) return;
  const w = vtyWindows[wid];
  w.buffer += d.data;
  if (w.buffer.length > 120000) w.buffer = w.buffer.slice(-80000);
  if (w.tab) vtyTabComplete(wid, d.data);
  renderVtyPop(wid);
}

function vtyOnError(d) {
  const wid = findVtyWid(d.key);
  if (wid) { vtyWindows[wid].buffer += `\x1b[err]ERROR: ${d.msg}\x1b[/]\r\n`; renderVtyPop(wid); }
}

function vtyOnDisc(d) {
  const wid = findVtyWid(d.key);
  if (wid) {
    vtyWindows[wid].buffer += '\r\n--- disconnected ---\r\n';
    renderVtyPop(wid);
    vtyWindows[wid].key = null;
    document.getElementById(wid+'-prm').textContent = '$ ';
  }
}

// ═══ Dragging ═══
let dragState = null;

function startDrag(e, wid) {
  if (e.target.tagName === 'SELECT' || e.target.tagName === 'BUTTON') return;
  const el = document.getElementById(wid);
  dragState = { el, startX: e.clientX, startY: e.clientY, origLeft: el.offsetLeft, origTop: el.offsetTop };
  // Bring to front
  document.querySelectorAll('.vty-popup').forEach(p => p.style.zIndex = 200);
  el.style.zIndex = 201;
  e.preventDefault();
}

document.addEventListener('mousemove', e => {
  if (!dragState) return;
  const dx = e.clientX - dragState.startX;
  const dy = e.clientY - dragState.startY;
  dragState.el.style.left = (dragState.origLeft + dx) + 'px';
  dragState.el.style.top  = (dragState.origTop + dy) + 'px';
});

document.addEventListener('mouseup', () => { dragState = null; });

// ═══ Helpers ═══
function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

// ═══ Init ═══
connectWs();
</script>
<style>
#rec-result{display:none;position:fixed;right:14px;bottom:14px;max-width:min(720px,92vw);z-index:9999;
  background:var(--panel,#1b1e24);color:var(--fg,#e6e6e6);border:1px solid var(--border,#3a3f4b);
  border-radius:8px;padding:12px 14px;box-shadow:0 6px 24px rgba(0,0,0,.45);font-size:12px}
#rec-result code{background:rgba(127,127,127,.15);padding:2px 5px;border-radius:4px;
  word-break:break-all;font-family:ui-monospace,Menlo,Consolas,monospace;display:inline-block}
#rec-result .rec-h{font-weight:600;display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
#rec-result .rec-row{margin:4px 0;line-height:1.5}
#rec-result .rec-cmd{margin:8px 0;padding:8px;border-radius:6px;background:rgba(127,127,127,.08)}
#rec-result .rec-tag{display:inline-block;font-weight:700;font-size:10px;padding:1px 6px;border-radius:4px;margin-right:6px}
#rec-result .rec-tag.ciph{background:#7a2530;color:#ffd7d7}
#rec-result .rec-tag.deciph{background:#22603a;color:#d7ffe6}
#rec-result .btn{cursor:pointer}
.a5tag{font-weight:700}
.a5tag.a5on{background:#22603a;color:#d7ffe6}
.a5tag.a5off{background:#5a3a3a;color:#ffd7d7}
.a5tag.a5live{box-shadow:0 0 0 2px rgba(255,90,90,.55)}
</style>
<div id="rec-result"></div>
<script>
var recRunning=false;
function updateA5(a){ var el=document.getElementById('tag-a5'); if(!el)return;
  var on=((a.mode||'').replace(/\s/g,'').toLowerCase()==='a51')||a.algo>=1;
  el.textContent=on?('🔒 A5/'+(a.algo>=1?a.algo:1)+(a.active?' ●':'')):'🔓 clair (A5/0)';
  el.className='htag a5tag '+(on?'a5on':'a5off')+(a.active?' a5live':'');
  el.title='Mode de SESSION (osmo-bsc encryption) = '+(a.mode||'?')
          +' · clé observée ce run : '+(a.active?('oui, A5/'+a.algo):'pas encore')
          +' — le badge suit la session, pas les trames';
  window._lastKc=a.lastKc||window._lastKc||''; var kf=document.getElementById('rec-kc'); if(kf) kf.placeholder=window._lastKc?('Kc auto: '+window._lastKc):'Kc auto (aucun capté)'; }
function toggleRec(){ if(recRunning){send({type:'record_stop'});} else {send({type:'record_start',source:document.getElementById('rec-src').value,m:document.getElementById('rec-m').value,t:parseInt(document.getElementById('rec-t').value,10),kc:document.getElementById('rec-kc').value});} }
function fillKc(){ var kf=document.getElementById('rec-kc'); if(kf&&window._lastKc) kf.value=window._lastKc; }
function recFmtBytes(b){ if(b>=1e9)return (b/1e9).toFixed(2)+' Go'; if(b>=1e6)return (b/1e6).toFixed(1)+' Mo'; if(b>=1e3)return (b/1e3).toFixed(0)+' Ko'; return (b||0)+' o'; }
function setRec(on){ recRunning=on; var t=document.getElementById('tag-rec'), b=document.getElementById('rec-btn');
  if(b)b.textContent=on?'■ Stop rec':'⏺ Rec cfile'; if(t){t.textContent=on?'REC ●':'rec off'; t.style.color=on?'#e5484d':'';} }
function onRecStatus(d){ setRec(!!d.running); if(d.running){var t=document.getElementById('tag-rec'); if(t)t.textContent='REC ● '+recFmtBytes(d.bytes)+' / '+(d.seconds||0)+'s';} }
function recCopy(id){ var el=document.getElementById(id); if(el&&navigator.clipboard)navigator.clipboard.writeText(el.textContent); }
function onRecResult(d){ setRec(false); var box=document.getElementById('rec-result'); if(!box)return;
  var kc=d.kcPresent?('🔒 Kc (A5/'+d.kcAlgo+') = '+d.kc+(d.kcFromCache?(' (capté il y a '+Math.round((d.kcAgeMs||0)/1000)+'s)'):(d.kcManual?' (saisi)':' (live)'))):'Kc absent — lance une session chiffrée puis re-record';
  function bloc(tag,cls,id,txt){ return txt?('<div class="rec-cmd"><span class="rec-tag '+cls+'">'+tag+'</span> <button class="btn" onclick="recCopy(\''+id+'\')">copier</button><div><code id="'+id+'"></code></div></div>'):''; }
  box.style.display='block';
  box.innerHTML=
   '<div class="rec-h">⏺ tranche enregistrée<button class="btn" onclick="document.getElementById(\'rec-result\').style.display=\'none\'">✕</button></div>'+
   '<div class="rec-row"><b>Source</b> <code>'+(d.srcFile||'?')+'</code> — fichier <b>continu</b>, offset '+(d.offset||0)+'</div>'+
   '<div class="rec-row"><b>Tranche DL</b> '+recFmtBytes(d.bytes)+' · '+d.seconds+'s · -m '+(d.mode||'?')+' -t '+(d.timeslot!=null?d.timeslot:'?')+(d.note?' · '+d.note:'')+'</div>'+
   '<div class="rec-row">'+kc+'</div>'+
   bloc('1. EXTRAIRE — depuis l\'HÔTE','ciph','rec-dd',d.ddCmd)+
   bloc('(sortie du conteneur : incluse dans la commande ci-dessus)','ciph','rec-cp',d.cpCmd)+
   bloc('2. DECIPHERED','deciph','rec-cmd-d',d.cmdDeciphered)+
   bloc('2. CIPHERED','ciph','rec-cmd-c',d.cmdCiphered);
  function put(id,txt){ var e=document.getElementById(id); if(e)e.textContent=txt||''; }
  put('rec-dd',d.ddCmd); put('rec-cp',d.cpCmd);
  put('rec-cmd-d',d.cmdDeciphered); put('rec-cmd-c',d.cmdCiphered);
  put('rec-dd-u',d.ddCmdUl); put('rec-cp-u',d.cpCmdUl);
  put('rec-cmd-ud',d.cmdUlDeciphered); put('rec-cmd-uc',d.cmdUlCiphered);
  if(d.hint){ box.innerHTML+='<div class="rec-row" style="opacity:.8;font-size:11px;margin-top:6px">'+d.hint+'</div>';
              put('rec-dd',d.ddCmd); put('rec-cp',d.cpCmd);
              put('rec-cmd-d',d.cmdDeciphered); put('rec-cmd-c',d.cmdCiphered);
              put('rec-dd-u',d.ddCmdUl); put('rec-cp-u',d.cpCmdUl);
              put('rec-cmd-ud',d.cmdUlDeciphered); put('rec-cmd-uc',d.cmdUlCiphered); }
}
</script>
