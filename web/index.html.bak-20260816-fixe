<div id="vty-layer"></div>

<script>
// ═══ Theme ═══
// ─── Micro : navigateur → WebSocket (binaire) → sink gsm_mic ────────────────
// Le conteneur n'a aucune capture reelle. Avant le 2026-08-08, `gsm_in`
// retombait sur la source par defaut = gsm_audio.monitor, donc sur la SORTIE
// des mobiles : ca faisait « du son en entree », mais c'etait l'echo, et ca
// bouclait (RMS x11 en 10 s). `gsm_in` pointe desormais sur un sink vide, ce
// qui ouvre la boucle mais rend l'entree muette. Ce bouton la remplit.
//
// PIEGE NAVIGATEUR : getUserMedia exige un CONTEXTE SECURISE. En http:// sur
// une IP distante il echoue, silencieusement pour l'utilisateur. On le dit.
var micOn = false, micCtx = null, micStream = null, micNode = null, micSrc = null, micLp = null;
var micPeak = 0, micVuTimer = null, micSrvTxt = '';
var MIC_DEV_KEY = 'osmo.micDeviceId';

function micBtn()  { return document.getElementById('mic-btn'); }
function micFail(m) {
  micOn = false;
  var b = micBtn();
  if (b) { b.textContent = '🎤 Parler'; b.classList.remove('primary'); }
  micVuHide();
  console.error('mic: ' + m);
  alert('Micro indisponible : ' + m);
}

// ─── Choix de l'entree : c'est le poste CLIENT qui decide ───────────────────
// Les noms de peripheriques changent d'une machine a l'autre et les deviceId
// sont propres a chaque navigateur : on ne peut donc rien coder en dur, et le
// deviceId memorise peut tres bien ne plus exister au prochain poste. D'ou la
// reprise sur OverconstrainedError plus bas : on retombe sur le defaut plutot
// que d'echouer. Les libelles restent vides tant qu'aucune permission n'a ete
// accordee (regle des navigateurs) : la liste se remplit apres le 1er 🎤.
async function micListDevices() {
  var sel = document.getElementById('mic-dev');
  if (!sel || !navigator.mediaDevices || !navigator.mediaDevices.enumerateDevices) return;
  var saved = localStorage.getItem(MIC_DEV_KEY) || '';
  var devs;
  try { devs = await navigator.mediaDevices.enumerateDevices(); } catch (e) { return; }
  var ins = devs.filter(function(d) { return d.kind === 'audioinput'; });
  sel.innerHTML = '';
  var opt = document.createElement('option');
  opt.value = ''; opt.textContent = 'micro : defaut';
  sel.appendChild(opt);
  ins.forEach(function(d, i) {
    var o = document.createElement('option');
    o.value = d.deviceId;
    o.textContent = d.label || ('entree ' + (i + 1));
    sel.appendChild(o);
  });
  // Le deviceId memorise vient peut-etre d'une AUTRE machine : s'il n'est plus
  // dans la liste, on revient au defaut au lieu de garder un choix fantome.
  if (saved && ins.some(function(d) { return d.deviceId === saved; })) sel.value = saved;
  else { sel.value = ''; if (saved) localStorage.removeItem(MIC_DEV_KEY); }
}
function micPickDevice(id) {
  if (id) localStorage.setItem(MIC_DEV_KEY, id); else localStorage.removeItem(MIC_DEV_KEY);
  // Changer d'entree en cours de route = relancer la capture sur la nouvelle.
  if (micOn) { toggleMic().then(function() { toggleMic(); }); }
}
if (navigator.mediaDevices && navigator.mediaDevices.addEventListener) {
  // Casque branche/debranche, dock change : la liste bouge sans rechargement.
  navigator.mediaDevices.addEventListener('devicechange', function() { micListDevices(); });
}
micListDevices();

// ─── Vu-metre : le SEUL moyen de distinguer « ca debite » de « ca porte » ────
// Panne vecue le 2026-08-12 : bonne cadence d'octets, contenu integralement nul.
// A gauche le niveau mesure ICI (avant l'envoi), a droite ce que le conteneur a
// reellement recu (message mic_stat du serveur). Les deux a zero = entree muette.
function micVuShow() {
  var el = document.getElementById('mic-vu');
  if (!el) return;
  el.style.display = '';
  clearInterval(micVuTimer);
  micVuTimer = setInterval(function() {
    var pct = Math.min(100, Math.round(micPeak * 100));
    var bars = Math.round(pct / 10);
    el.textContent = '🎙 ' + '▇'.repeat(bars) + '·'.repeat(10 - bars) + ' ' + pct + '%'
                   + (micSrvTxt ? '  ' + micSrvTxt : '');
    el.className = 'htag' + (pct > 1 ? ' on' : '');
    micPeak = 0;
  }, 500);
}
function micVuHide() {
  clearInterval(micVuTimer); micVuTimer = null; micPeak = 0; micSrvTxt = '';
  var el = document.getElementById('mic-vu');
  if (el) { el.style.display = 'none'; el.textContent = '—'; el.className = 'htag'; }
}

async function toggleMic() {
  var btn = micBtn();
  if (micOn) {
    micOn = false;
    try { if (micNode) micNode.disconnect(); if (micLp) micLp.disconnect(); if (micSrc) micSrc.disconnect(); } catch (e) {}
    try { if (micStream) micStream.getTracks().forEach(function(t){ t.stop(); }); } catch (e) {}
    try { if (micCtx) micCtx.close(); } catch (e) {}
    micCtx = micStream = micNode = micSrc = micLp = null;
    send({ type: 'mic_stop' });
    btn.textContent = '🎤 Parler'; btn.classList.remove('primary');
    micVuHide();
    return;
  }
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    return micFail("getUserMedia absent. La capture micro exige un contexte securise : "
                 + "servez la page en https://, ou ouvrez-la depuis http://localhost "
                 + "(un tunnel SSH -L convient).");
  }
  var want = localStorage.getItem(MIC_DEV_KEY) || '';
  var base = { channelCount: 1, echoCancellation: true,
               noiseSuppression: true, autoGainControl: true };
  try {
    var c = Object.assign({}, base);
    if (want) c.deviceId = { exact: want };
    micStream = await navigator.mediaDevices.getUserMedia({ audio: c });
  } catch (e) {
    // Machine changee, casque debranche : le deviceId memorise n'existe plus.
    // On ne meurt pas dessus, on reprend le defaut et on nettoie la memoire.
    if (want && (e.name === 'OverconstrainedError' || e.name === 'NotFoundError')) {
      localStorage.removeItem(MIC_DEV_KEY);
      try { micStream = await navigator.mediaDevices.getUserMedia({ audio: base }); }
      catch (e2) { return micFail(e2.name + ' — ' + e2.message); }
      console.warn('mic: entree memorisee introuvable sur cette machine — retour au defaut');
    } else { return micFail(e.name + ' — ' + e.message); }
  }
  micListDevices();   // les libelles ne sont lisibles qu'apres la permission

  // 8 kHz demande directement au contexte : c'est le debit du TCH (GSM-FR).
  // Si le navigateur refuse, on rechantillonne a la main plus bas.
  try { micCtx = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: 8000 }); }
  catch (e) { micCtx = new (window.AudioContext || window.webkitAudioContext)(); }
  var ratio = micCtx.sampleRate / 8000;
  micSrc  = micCtx.createMediaStreamSource(micStream);
  micNode = micCtx.createScriptProcessor(2048, 1, 1);   // deprecie mais universel
  var acc = 0.0;
  micNode.onaudioprocess = function(ev) {
    if (!micOn || !ws || ws.readyState !== 1) return;
    var inp = ev.inputBuffer.getChannelData(0);
    var out = new Int16Array(Math.ceil(inp.length / ratio));
    var n = 0;
    // Decimation (cf. le passe-bas installe juste apres : il enleve ce qui se
    // replierait ici). Prise du niveau au passage — c'est ce que le vu-metre
    // affiche, et c'est mesure APRES filtrage, donc sur ce qui part vraiment.
    for (var i = 0; i < inp.length; i++) {
      var s = inp[i] < 0 ? -inp[i] : inp[i];
      if (s > micPeak) micPeak = s;
      acc += 1;
      if (acc >= ratio) {
        acc -= ratio;
        var v = Math.max(-1, Math.min(1, inp[i]));
        out[n++] = v < 0 ? v * 0x8000 : v * 0x7FFF;
      }
    }
    if (n > 0) ws.send(out.buffer.slice(0, n * 2));
  };

  // ─── Anti-repliement AVANT decimation ────────────────────────────────────
  // Chrome honore sampleRate:8000, Safari/WebKit et certaines configurations
  // Firefox l'ignorent et rendent 44,1 ou 48 kHz : la boucle ci-dessus ne garde
  // alors qu'un echantillon sur 5,5 ou 6. Sans filtre, TOUT le 4-24 kHz se
  // replie dans la bande utile. Le codec FR filtre bien au-dessus de 3,4 kHz,
  // mais APRES : le repliement a deja eu lieu, il ne peut plus l'enlever.
  // Deux biquads en cascade a 3,4 kHz — 4 lignes, aucune dependance. A 8 kHz
  // natif la chaine est inaudible (fc au-dessus de la bande transmise).
  var fc = Math.min(3400, micCtx.sampleRate * 0.45);
  micLp = micCtx.createBiquadFilter();
  micLp.type = 'lowpass'; micLp.frequency.value = fc; micLp.Q.value = 0.707;
  var lp2 = micCtx.createBiquadFilter();
  lp2.type = 'lowpass'; lp2.frequency.value = fc; lp2.Q.value = 0.707;
  micSrc.connect(micLp); micLp.connect(lp2); lp2.connect(micNode);
  micNode.connect(micCtx.destination);   // requis par Chrome pour cadencer le noeud
  if (Math.abs(micCtx.sampleRate - 8000) > 1)
    console.info('mic: contexte a ' + micCtx.sampleRate + ' Hz (8000 refuse) — '
               + 'decimation 1/' + ratio.toFixed(2) + ' avec passe-bas ' + Math.round(fc) + ' Hz');
  micOn = true;
  send({ type: 'mic_start' });
  btn.textContent = '🔴 Micro ON'; btn.classList.add('primary');
  micVuShow();
}

// Le serveur peut couper le micro sans nous : pacat mort, sink gsm_mic disparu,
// PulseAudio du conteneur redemarre. Avant, le bouton restait rouge et on
// parlait dans le vide. Desormais l'IHM suit l'etat REEL du pont.
function micOnServerState(d) {
  if (!d) return;
  if (d.on) { micSrvTxt = ''; return; }
  if (micOn) {
    micOn = false;
    try { if (micNode) micNode.disconnect(); if (micLp) micLp.disconnect(); if (micSrc) micSrc.disconnect(); } catch (e) {}
    try { if (micStream) micStream.getTracks().forEach(function(t){ t.stop(); }); } catch (e) {}
    try { if (micCtx) micCtx.close(); } catch (e) {}
    micCtx = micStream = micNode = micSrc = micLp = null;
    var b = micBtn(); if (b) { b.textContent = '🎤 Parler'; b.classList.remove('primary'); }
    micVuHide();
  }
  if (d.reason) alert('Micro coupe cote conteneur : ' + d.reason);
}
// Cote conteneur : ms d'audio recus par seconde, echantillons non nuls, crete,
// arriere (derive d'horloge) et ms jetes. « 1000 ms/s, 0 non nuls » = le pont
// transporte parfaitement du silence : la panne est en amont, dans le navigateur.
function micOnServerStat(d) {
  if (!d) return;
  micSrvTxt = '→ ' + d.ms + 'ms/s ' + (d.nonzero ? 'crete ' + d.peak : 'TOUT A ZERO')
            + (d.droppedMs ? ' (−' + d.droppedMs + 'ms)' : '')
            + (d.backlogMs > 120 ? ' retard ' + d.backlogMs + 'ms' : '');
}

var audioPlaying = false;
function toggleAudio() {
  var el = document.getElementById('audio-stream'), btn = document.getElementById('audio-btn');
  if (!audioPlaying) {
    el.src = '/audio?t=' + Date.now();           // flux MP3 chunké (serveur strip le ?query)
    el.play().then(function(){ audioPlaying = true; btn.textContent = '⏸ Audio'; })
      .catch(function(err){ console.error('audio play failed', err); el.removeAttribute('src'); el.load(); });
  } else {
    el.pause(); el.removeAttribute('src'); el.load();   // ferme la connexion -> refcount serveur
    audioPlaying = false; btn.textContent = '▶ Audio';
  }
}
(function(){ var el = document.getElementById('audio-stream'); if (!el) return;
  el.addEventListener('error', function(){ if (audioPlaying){ audioPlaying=false; document.getElementById('audio-btn').textContent='▶ Audio'; } }); })();
function toggleTheme() {
  const html = document.documentElement;
  const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
  html.dataset.theme = next;
  document.getElementById('theme-toggle').textContent = next === 'dark' ? '◐' : '◑';
  try { localStorage.setItem('osmo-theme', next); } catch {}
}
try {
  const saved = localStorage.getItem('osmo-theme');
  if (saved) { document.documentElement.dataset.theme = saved; document.getElementById('theme-toggle').textContent = saved === 'dark' ? '◐' : '◑'; }
} catch {}

// ═══ FFT view (MS & BTS) — logique portée de fft_web.py, données via /psd ═══
var FFT_REFRESH_MS = 150;        // ~7 img/s × 2 sources ; ajustable
var fftTimer = null;
function fftCmap(v){v=Math.max(0,Math.min(1,v));var h=(1-v)*240,l=0.12+0.5*v,a=1*Math.min(l,1-l);
 var f=function(n){var k=(n+h/30)%12;return Math.round(255*(l-a*Math.max(-1,Math.min(k-3,9-k,1))));};
 return [f(0),f(8),f(4)];}
function fftDrawPsd(src,d){var c=document.getElementById('c-'+src),x=c.getContext('2d');
 var W=c.width=c.clientWidth*2,H=c.height=c.clientHeight*2;x.clearRect(0,0,W,H);
 var p=d.psd,n=p.length;if(!n)return;var mn=Math.min.apply(null,p),mx=Math.max.apply(null,p),rg=(mx-mn)||1;
 x.strokeStyle='#16222b';x.lineWidth=1;for(var g=0;g<=4;g++){var yy=H*g/4;x.beginPath();x.moveTo(0,yy);x.lineTo(W,yy);x.stroke();}
 x.beginPath();x.moveTo(W/2,0);x.lineTo(W/2,H);x.strokeStyle='#243845';x.stroke();
 x.strokeStyle='#2aa198';x.lineWidth=2;x.beginPath();
 var _z=Math.min(1, window.__fftzoom||1);
 for(var i=0;i<n;i++){var xx=W*0.5+((i/(n-1))-0.5)*W*_z,yy=H-(p[i]-mn)/rg*H*0.9-H*0.05;
  if(window.__fftflip) yy=H-yy;                 /* /fftcfg?flip=1 */
  i?x.lineTo(xx,yy):x.moveTo(xx,yy);}
 x.stroke();}
function fftDrawWf(src,d){var c=document.getElementById('w-'+src),x=c.getContext('2d');
 var p=d.psd,n=p.length;if(!n)return;
 if(c.width!==n){c.width=n;c.height=160;x.fillStyle='#060a0e';x.fillRect(0,0,n,c.height);}
 /* Sens pilote par /fftcfg?dir=up|down. */
 var _up = (window.__fftdir === 'up');
 x.drawImage(c,0,_up ? -1 : 1);
 var mn=Math.min.apply(null,p),mx=Math.max.apply(null,p),rg=(mx-mn)||1;
 var row=x.createImageData(n,1);
 for(var i=0;i<n;i++){var col=fftCmap((p[i]-mn)/rg),o=i*4;row.data[o]=col[0];row.data[o+1]=col[1];row.data[o+2]=col[2];row.data[o+3]=255;}
 x.putImageData(row,0,_up ? (c.height-1) : 0);}
function fftDraw(src,d){ if(d&&typeof d.wfdir==='string') window.__fftdir=d.wfdir;
 if(d&&typeof d.zoom==='number'&&d.zoom>0) window.__fftzoom=d.zoom;
 if(d&&typeof d.flip==='boolean') window.__fftflip=d.flip;
var e=document.getElementById('e-'+src),tt=document.getElementById('t-'+src);
 if(d.error){e.textContent=d.error;tt.textContent=d.label||'';return;} e.textContent='';
 tt.textContent=d.label+'  •  ARFCN '+d.arfcn+'  •  Fs '+(d.rate/1e6).toFixed(3)+' MHz';
 fftDrawPsd(src,d);fftDrawWf(src,d);}
function fftTick(){['ms','bts'].forEach(function(s){
  fetch('/psd?src='+s+'&t='+Date.now()).then(function(r){return r.json();}).then(function(d){fftDraw(s,d);}).catch(function(){});});}
// ── Logs colorisés (ANSI → HTML) : mobile.log (MS) + grgsm record (BTS) ──
var ANSI_FG = {30:'#586e75',31:'#dc322f',32:'#859900',33:'#b58900',34:'#268bd2',35:'#d33682',36:'#2aa198',37:'#eee8d5',
 90:'#657b83',91:'#cb4b16',92:'#859900',93:'#b58900',94:'#268bd2',95:'#6c71c4',96:'#2aa198',97:'#fdf6e3'};
function fftXterm256(n){
 if(n<16)return ['000000','800000','008000','808000','000080','800080','008080','c0c0c0','808080','ff0000','00ff00','ffff00','0000ff','ff00ff','00ffff','ffffff'][n];
 if(n>=232){var v=(8+(n-232)*10).toString(16);return (v.length<2?'0'+v:v).repeat(3);}
 n-=16;var lv=function(x){x=x?55+x*40:0;x=x.toString(16);return x.length<2?'0'+x:x;};
 return lv((n/36|0))+lv(((n%36)/6|0))+lv(n%6);}
function ansiToHtml(s){
 s=s.replace(/[&<>]/g,function(c){return c==='&'?'&amp;':c==='<'?'&lt;':'&gt;';});
 var out='',open=false,cur={},re=/\x1b\[([0-9;]*)m/g,last=0,m;
 while((m=re.exec(s))){
  out+=s.slice(last,m.index);last=re.lastIndex;if(open){out+='</span>';open=false;}
  var codes=m[1]===''?[0]:m[1].split(';').map(Number);
  for(var i=0;i<codes.length;i++){var c=codes[i];
   if(c===0)cur={};else if(c===1)cur.bold=true;else if(c===22)cur.bold=false;
   else if(c===39)cur.fg=null;else if(ANSI_FG[c])cur.fg=ANSI_FG[c];
   else if(c===38&&codes[i+1]===5){cur.fg='#'+fftXterm256(codes[i+2]|0);i+=2;}
   else if(c===38&&codes[i+1]===2){cur.fg='rgb('+(codes[i+2]|0)+','+(codes[i+3]|0)+','+(codes[i+4]|0)+')';i+=4;}}
  var st=(cur.fg?'color:'+cur.fg+';':'')+(cur.bold?'font-weight:700;':'');
  if(st){out+='<span style="'+st+'">';open=true;}}
 out+=s.slice(last);if(open)out+='</span>';return out;}
var fftLogTimer=null;
function fftLogTick(){['ms','bts'].forEach(function(w){
  fetch('/logtail?which='+w+'&t='+Date.now()).then(function(r){return r.json();}).then(function(d){
   var el=document.getElementById('log-'+w);if(!el)return;
   var atBottom=el.scrollHeight-el.scrollTop-el.clientHeight<30;
   el.innerHTML=d.error?'<span style="color:#dc322f">'+d.error+'</span>':ansiToHtml(d.text||'');
   if(atBottom)el.scrollTop=el.scrollHeight;
  }).catch(function(){});});}
function switchView(v){
  if(v==='fft') v='fft1';                                  // compat ancien appel
  var fft = (v==='fft1'||v==='fft2'||v==='fft3');
  var native = (v==='fft1');                                  // pane native : canvases + logs pilotes par fftTick
  var frameSrc = v==='fft2'?'fft.html':(v==='fft3'?'fft_diff.html':'');
  document.getElementById('main').style.display = fft?'none':'';
  document.getElementById('fft-view').style.display = fft?'':'none';
  document.getElementById('vtab-console').classList.toggle('active',!fft);
  ['fft1','fft2','fft3'].forEach(function(id){
    var b=document.getElementById('vtab-'+id); if(b) b.classList.toggle('active',v===id);
  });
  var nat=document.getElementById('fft-native'), frm=document.getElementById('fft-frame'), ovl=document.getElementById('fft-overlay');
  if(nat) nat.style.display = native?'':'none';
  if(frm){                                                     // FFT 2/3 : meme rendu /psd, mais inline (iframe), pas de nouvel onglet
    if(frameSrc){ if(frm.getAttribute('src')!==frameSrc) frm.setAttribute('src',frameSrc); frm.style.display=''; }
    else frm.style.display='none';
  }
  /* [2026-08-09] plus de calque : l element n existe plus, ovl vaut null. */
  if(native){                                                  // les timers natifs ne tournent que pour FFT 1 ; 2/3 pollent eux-memes
    if(!fftTimer){ fftTick(); fftTimer=setInterval(fftTick,FFT_REFRESH_MS); }
    if(!fftLogTimer){ fftLogTick(); fftLogTimer=setInterval(fftLogTick,1000); }
  } else {
    if(fftTimer){ clearInterval(fftTimer); fftTimer=null; }
    if(fftLogTimer){ clearInterval(fftLogTimer); fftLogTimer=null; }
  }
}

