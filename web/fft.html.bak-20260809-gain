<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Calypso I/Q FFT — MS vs BTS</title>
<style>
  :root{
    --bg:#0a1622; --panel:#0c1a28; --sep:#06101a;
    --trace:#5fd0c8; --trace-glow:#5fd0c855;
    --ink:#74e0d0; --muted:#5a8a86; --grid:#13283a;
    --hot:#ff6a3d;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{
    background:var(--bg); color:var(--ink);
    font:13px/1.4 ui-monospace,"SF Mono",Menlo,Consolas,"Liberation Mono",monospace;
    -webkit-font-smoothing:antialiased; overflow:hidden;
    display:flex; flex-direction:column;
  }
  header{
    display:flex; align-items:center; gap:12px;
    padding:8px 14px; border-bottom:1px solid var(--sep);
    background:linear-gradient(180deg,#0d1d2c,#0a1622);
    flex:0 0 auto;
  }
  header .dish{font-size:14px}
  header h1{
    margin:0; font-size:13px; font-weight:600; letter-spacing:.3px;
    color:var(--ink);
  }
  header h1 small{color:var(--muted); font-weight:400}
  .pill{
    margin-left:auto; display:inline-flex; align-items:center; gap:6px;
    padding:3px 9px; border:1px solid var(--grid); border-radius:999px;
    color:var(--muted); font-size:11px; letter-spacing:.5px; cursor:pointer;
    user-select:none;
  }
  .pill .dot{width:7px;height:7px;border-radius:50%;background:var(--muted)}
  .pill.live{color:#9fe9a0;border-color:#2c5e3a}
  .pill.live .dot{background:#5fd06a;box-shadow:0 0 7px #5fd06a}

  main{flex:1 1 auto; min-height:0; display:flex; flex-direction:column}
  .group{flex:1 1 0; min-height:0; display:flex; flex-direction:column}
  .group.bts{justify-content:flex-end}            /* mirror: BTS label/line outside */
  .label{
    padding:5px 14px 4px; color:var(--muted); font-size:11px;
    letter-spacing:.3px; flex:0 0 auto;
  }
  .label b{color:var(--ink); font-weight:600}
  .label .arf{color:var(--trace)}
  canvas{display:block; width:100%}
  canvas.line{flex:1 1 0; min-height:60px; background:transparent}
  canvas.wf{flex:1 1 0; min-height:70px; background:#04101c}
  .seam{height:1px; background:var(--sep); flex:0 0 auto}
  footer{
    flex:0 0 auto; padding:4px 14px; border-top:1px solid var(--sep);
    color:var(--muted); font-size:10.5px; letter-spacing:.2px;
  }
  footer code{color:var(--trace)}
  @media (max-width:560px){ .label{font-size:10px} header h1 small{display:none} }

  /* [2026-08-09] Barre de reglages : palette / intensite / zoom / sens.
     Les reglages vivent sur le SERVEUR (/fftcfg) et non dans la page : les deux
     pages FFT et la console partagent donc le meme etat, et un rechargement ne
     le perd pas. La barre ne fait que le lire et le pousser. */
  .fftctl{display:inline-flex;align-items:center;gap:8px;margin-left:auto;
          font:11px ui-monospace,Menlo,Consolas,monospace;color:#5a8a86}
  .fftctl label{display:inline-flex;align-items:center;gap:4px}
  .fftctl select,.fftctl button{background:#0e1c2a;color:#74e0d0;border:1px solid #1c3850;
          border-radius:5px;padding:2px 6px;font:inherit;cursor:pointer}
  .fftctl input[type=range]{width:80px;accent-color:#5fd0c8;cursor:pointer}
  .fftctl b{color:#74e0d0;font-weight:600;min-width:34px;display:inline-block;text-align:right}
</style>
</head>
<body>
<header>
  <span class="dish">📡</span>
  <h1>Calypso&nbsp;I/Q&nbsp;FFT <small>— MS vs BTS</small></h1>
  <span class="pill" id="modePill" title="click to toggle demo / live"><span class="dot"></span><span id="modeTxt">DEMO</span></span>
  <span class="fftctl">
  <label>palette <select id="c-pal"></select></label>
  <label>intensité <input id="c-dr" type="range" min="10" max="90" step="5"><b id="c-drv">40</b></label>
  <label>zoom <select id="c-zoom"><option value="0.25">0.25×</option><option value="0.5">0.5×</option><option value="1">1×</option><option value="2">2×</option><option value="4">4×</option><option value="8">8×</option><option value="16">16×</option></select></label>
  <button id="c-dir" title="sens de défilement de la CASCADE">cascade ↓</button>
  <button id="c-flip" title="retourne la COURBE de spectre">spectre ↑</button>
</span>
</header>

<main>
  <!-- MS : line on top, waterfall below -->
  <section class="group ms">
    <div class="label" id="lbl-ms">MS — <b>Calypso DSP</b> (dsp_iq) · <span class="arf">ARFCN 514</span> · Fs 1.083 MHz</div>
    <canvas class="line" data-ch="ms"></canvas>
    <canvas class="wf"   data-ch="ms"></canvas>
  </section>

  <div class="seam"></div>

  <!-- BTS : waterfall on top, line below (mirror of MS) -->
  <section class="group bts">
    <canvas class="wf"   data-ch="bts"></canvas>
    <canvas class="line" data-ch="bts"></canvas>
    <div class="label" id="lbl-bts">BTS — <b>DL relay LIVE</b> (iq_fft.fifo) · <span class="arf">ARFCN 514</span> · Fs 1.083 MHz</div>
  </section>
</main>

<footer>live ← <code>/psd?src=ms|bts</code> (Welch PSD natif, server.js) · normalisé dB→0..1 · fallback démo si pas de flux</footer>

<script>
"use strict";

/* ---- turbo colormap LUT (Mikhailov polynomial), 256 entries ---- */
/* [2026-08-09] PALETTES PILOTEES PAR LE SERVEUR (/fftcfg, defaut inferno).
 * turbo garde sa formule d origine ; inferno/magma/viridis sont interpolees sur
 * les ancres matplotlib et sont PERCEPTUELLEMENT UNIFORMES — une variation egale
 * de dB donne une variation egale a l oeil, la ou l arc-en-ciel fabrique des
 * frontieres de teinte que les donnees n ont pas. */
const PAL_ANCHORS = {
  inferno: [[0,0,4],[22,11,57],[66,10,104],[106,23,110],[147,38,103],[188,55,84],[221,81,58],[243,120,25],[252,255,164]],
  magma:   [[0,0,4],[28,16,68],[79,18,123],[129,37,129],[181,54,122],[229,80,100],[251,135,97],[254,194,135],[252,253,191]],
  viridis: [[68,1,84],[72,40,120],[62,74,137],[49,104,142],[38,130,142],[31,158,137],[53,183,121],[109,205,89],[253,231,37]],
  gray:    [[0,0,0],[32,32,32],[64,64,64],[96,96,96],[128,128,128],[160,160,160],[192,192,192],[224,224,224],[255,255,255]]
};
function _palTurbo(){ const l=new Uint8Array(768), cb=v=>(v<0?0:v>255?255:v|0);
  for(let i=0;i<256;i++){ const x=i/255,x2=x*x,x3=x2*x,x4=x2*x2,x5=x4*x;
    l[i*3]  =cb((0.13572138+4.6153926*x-42.66032258*x2+132.13108234*x3-152.94239396*x4+59.28637943*x5)*255);
    l[i*3+1]=cb((0.09140261+2.19418839*x+4.84296658*x2-14.18503333*x3+4.27729857*x4+2.82956604*x5)*255);
    l[i*3+2]=cb((0.1066733+12.64194608*x-60.58204836*x2+110.36276771*x3-89.90310912*x4+27.34824973*x5)*255);
  } return l; }
function _palAnch(A){ const l=new Uint8Array(768), sg=A.length-1;
  for(let i=0;i<256;i++){ const t=i/255*sg, k=Math.min(sg-1,t|0), f=t-k;
    for(let c=0;c<3;c++) l[i*3+c]=(A[k][c]*(1-f)+A[k+1][c]*f+0.5)|0; } return l; }
const _PALC = {};
function makePalette(n){ n=(n||'inferno').toLowerCase();
  if(_PALC[n]) return _PALC[n];
  return _PALC[n] = (n==='turbo') ? _palTurbo() : _palAnch(PAL_ANCHORS[n]||PAL_ANCHORS.inferno); }
let TURBO = makePalette('inferno');
let SRV = { palette:'inferno', dr:40, wfdir:'down', flip:false, zoom:1 };
/* [2026-08-09] DEZOOM (<1) : cote serveur il n y a rien de plus large que la
 * bande complete, donc 0.5x et 0.25x n y font rien. Ici, en revanche, ils ont
 * un sens : on trace la bande ENTIERE sur une fraction de la largeur, centree,
 * avec des marges. zx vaut 1 des que zoom>=1 (au-dela c est le serveur qui
 * rogne, la largeur reste pleine). */
function zx(){ return Math.min(1, SRV.zoom || 1); }
function xmap(i, n, W){ const t=(n>1)?(i/(n-1)):0.5; return W*0.5 + (t-0.5)*W*zx(); }
function applySrvCfg(j){ if(!j) return;
  if(j.palette && j.palette!==SRV.palette){ SRV.palette=j.palette; TURBO=makePalette(j.palette); }
  if(typeof j.dr==='number' && j.dr>0) SRV.dr=j.dr;
  if(typeof j.wfdir==='string' && j.wfdir) SRV.wfdir=j.wfdir;
  if(typeof j.flip==='boolean') SRV.flip=j.flip;
  if(typeof j.zoom==='number' && j.zoom>0) SRV.zoom=j.zoom; }


const DPR = Math.min(window.devicePixelRatio || 1, 2);
const clamp01 = v => v < 0 ? 0 : v > 1 ? 1 : v;

/* ---- resample an arbitrary-length magnitude array to width w ---- */
function resample(src, w){
  const n = src.length;
  if (n === w) return src;
  const out = new Float32Array(w);
  for (let x = 0; x < w; x++){
    const p = x / (w - 1) * (n - 1), i = p | 0, f = p - i;
    out[x] = i + 1 < n ? src[i]*(1-f) + src[i+1]*f : src[i];
  }
  return out;
}

class Panel {
  constructor(ch){
    this.ch = ch;
    this.line = document.querySelector(`canvas.line[data-ch="${ch}"]`);
    this.wf   = document.querySelector(`canvas.wf[data-ch="${ch}"]`);
    this.lc = this.line.getContext('2d');
    this.wc = this.wf.getContext('2d', { willReadFrequently:false });
    this.mode = 'demo';                 // 'demo' | 'live'
    this.W = 2; this.wfH = 2;
    this.phase = Math.random()*6.28;
    this.tilt  = ch === 'bts' ? 1 : 0;  // slight visual variation between panels
    this.resize();
  }
  resize(){
    // line canvas: crisp (DPR-scaled)
    const lw = this.line.clientWidth, lh = this.line.clientHeight;
    this.line.width = Math.max(2, lw*DPR); this.line.height = Math.max(2, lh*DPR);
    this.lc.setTransform(DPR,0,0,DPR,0,0);
    this.lw = lw; this.lh = lh;
    // waterfall canvas: 1x backing, one bin per pixel column
    const ww = Math.max(2, this.wf.clientWidth|0), wh = Math.max(2, this.wf.clientHeight|0);
    // preserve existing waterfall on resize where possible
    const prev = (this.wf.width && this.wf.height)
      ? this.wc.getImageData(0,0,this.wf.width,this.wf.height) : null;
    this.wf.width = ww; this.wf.height = wh;
    this.W = ww; this.wfH = wh;
    this.wc.fillStyle = '#04101c'; this.wc.fillRect(0,0,ww,wh);
    if (prev) this.wc.putImageData(prev,0,0);
    this._row = this.wc.createImageData(ww,1);
  }
  /* synthetic GMSK-ish spectrum: bell + noise floor + carrier + digital comb */
  synth(t){
    const W = this.W, m = new Float32Array(W), c = W/2, bw = W*0.165;
    const drift = Math.sin(t*0.0007 + this.phase)*0.015;
    for (let i = 0; i < W; i++){
      const d = (i - c) / bw;
      const bell = Math.exp(-d*d);
      const noise = Math.random()*0.07 + (Math.random()<0.004 ? Math.random()*0.35*bell : 0);
      m[i] = clamp01(0.10 + (0.74+drift)*bell + noise*(0.35+0.65*bell));
    }
    // hot carrier line at centre
    for (let k=-1;k<=1;k++){ const i=(c+k)|0; m[i]=clamp01(m[i]+0.18-0.06*Math.abs(k)); }
    // digital comb: regular lines across the passband, jittered in time
    const step = Math.max(6, W*0.045|0);
    for (let i = (c % step); i < W; i += step){
      const inband = Math.exp(-(((i-c)/(bw*1.25))**2));
      const j = 0.06 + 0.10*Math.abs(Math.sin(t*0.004 + i*0.3));
      m[i] = clamp01(m[i] + j*inband);
      if (i+1<W) m[i+1] = clamp01(m[i+1] + 0.5*j*inband);
    }
    return m;
  }
  drawLine(mags){
    const ctx = this.lc, W = this.lw, H = this.lh, N = mags.length;
    ctx.clearRect(0,0,W,H);
    // faint centre marker + baseline grid
    ctx.strokeStyle = 'rgba(95,208,200,0.10)'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(W/2,0); ctx.lineTo(W/2,H); ctx.stroke();
    // trace
    ctx.beginPath();
    for (let x = 0; x < W; x++){
      const v = mags[(x/(W-1)*(N-1))|0] || 0;
      /* [2026-08-09] AMPLITUDE DIVISEE PAR DEUX (0.94 -> 0.47). Le trace
       * occupait 94 % de la hauteur du canevas : la crete touchait le bord haut
       * et la jupe de bruit sortait par le bas, coupee la ou commence la
       * cascade — on ne voyait donc jamais la cloche entiere. 47 % la rendait
       * entiere mais riquiqui ; 85 % remplit la boite en gardant une marge en
       * haut et le plancher de bruit dedans. */
      /* Amplitude 0.47 (inchangee) mais BASE REMONTEE : le decalage bas passe
       * de 3 % a 45 % de la hauteur, donc le plancher de bruit se pose a 55 %
       * du cadre et la crete monte a 8 %. La cloche occupe la moitie haute au
       * lieu de coller au bas du canevas. 0.47 + 0.45 = 0.92 : elle tient. */
      /* [2026-08-09] TRANSLATION VERTICALE PURE : amplitude 0.85 conservee
       * (la forme ne change pas), on remonte seulement le trace de 12 % de la
       * hauteur du cadre. 0.85 + 0.12 = 0.97 : la crete garde 3 % de marge en
       * haut et la cloche entiere reste dans la boite. */
      let y = H - clamp01(v)*(H*0.85) - H*0.12;
      if (SRV.flip) y = H - y;                 /* retournement vertical (/fftcfg?flip=1) */
      x ? ctx.lineTo(x,y) : ctx.moveTo(x,y);
    }
    ctx.strokeStyle = 'var(--trace)'; ctx.lineWidth = 1;
    ctx.shadowColor = 'rgba(95,208,200,0.55)'; ctx.shadowBlur = 4;
    ctx.strokeStyle = '#5fd0c8'; ctx.stroke();
    ctx.shadowBlur = 0;
  }
  pushRow(mags){
    const W = this.W;
    const m = mags.length === W ? mags : resample(mags, W);
    const _z = zx(), _x0 = Math.round(W*0.5 - W*_z/2), _xw = Math.max(1, Math.round(W*_z));
    /* Sens pilote par /fftcfg?dir=up|down. down = ligne neuve EN HAUT. */
    const _up = (SRV.wfdir === 'up');
    this.wc.drawImage(this.wf, 0, _up ? -1 : 1);
    const d = this._row.data;
    for (let x = 0; x < W; x++){
      const idx = (clamp01(m[x]) * 255) | 0, o = idx*3, p = x*4;
      d[p]   = TURBO[o]; d[p+1] = TURBO[o+1]; d[p+2] = TURBO[o+2]; d[p+3] = 255;
    }
    this.wc.putImageData(this._row, 0, _up ? (this.wfH - 1) : 0);
  }
  frame(mags){ this.drawLine(mags); this.pushRow(mags); }
}

/* ---- boot ---- */
const panels = { ms: new Panel('ms'), bts: new Panel('bts') };
let RO;
function doResize(){ for (const k in panels) panels[k].resize(); }
window.addEventListener('resize', () => { clearTimeout(RO); RO = setTimeout(doResize, 120); });

const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const FRAME_MS = reduce ? 120 : 33;          // ~8fps reduced, ~30fps normal
let last = 0;
function loop(t){
  if (t - last >= FRAME_MS){
    last = t;
    for (const k in panels){ const p = panels[k]; if (p.mode === 'demo') p.frame(p.synth(t)); }
  }
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);

/* ---- PUBLIC live-data hook ----
   feedSpectrum('ms', float32Array)  /  feedSpectrum('bts', float32Array)
   One call = one waterfall row + one line redraw on that panel.            */
window.feedSpectrum = function(ch, mags){
  const p = panels[ch]; if (!p) return;
  if (p.mode !== 'live'){ p.mode = 'live'; setMode('LIVE'); }
  p.frame(mags);
};

/* mode pill */
const pill = document.getElementById('modePill'), modeTxt = document.getElementById('modeTxt');
function setMode(txt){
  modeTxt.textContent = txt;
  pill.classList.toggle('live', txt === 'LIVE');
}
pill.addEventListener('click', () => {       // manual toggle back to demo for testing
  const toDemo = pill.classList.contains('live');
  for (const k in panels) panels[k].mode = toDemo ? 'demo' : 'live';
  setMode(toDemo ? 'DEMO' : 'LIVE');
});

/* ════════════════════════════════════════════════════════════════════════
   LIVE — poll server.js /psd?src=ms|bts (Welch PSD en dB) → normalise 0..1
   → feedSpectrum(). Pas de WS : on réutilise l'endpoint HTTP natif existant.
   La démo synthétique reste en fallback tant qu'un canal n'a pas de flux.
   ════════════════════════════════════════════════════════════════════════ */
let PSD_DR = 40;   /* pilote par /fftcfg (SRV.dr) */                           // plage dynamique (dB) sous le max → 0..1
function applyMeta(ch, j){
  const el = document.getElementById('lbl-'+ch);
  if (!el || !j) return;
  const arf = j.arfcn ? j.arfcn : '514';
  const who = ch === 'ms' ? 'MS — <b>Calypso DSP</b> (dsp_iq)' : 'BTS — <b>DL relay LIVE</b> (iq_fft.fifo)';
  const fs  = j.rate ? (j.rate/1e6).toFixed(3) : '1.083';
  el.innerHTML = `${who} · <span class="arf">ARFCN ${arf}</span> · Fs ${fs} MHz`;
}
async function pollPsd(ch){
  try{
    const r = await fetch('/psd?src='+ch, { cache:'no-store' });
    const j = await r.json(); applySrvCfg(j); PSD_DR = SRV.dr;
    if (!j || j.error || !Array.isArray(j.psd) || !j.psd.length) return;   // garde la démo
    const psd = j.psd;
    let mx = -Infinity;
    for (let i=0;i<psd.length;i++) if (psd[i] > mx) mx = psd[i];
    const floor = mx - PSD_DR;
    const mags = new Float32Array(psd.length);
    for (let i=0;i<psd.length;i++){ const v=(psd[i]-floor)/PSD_DR; mags[i] = v<0?0:v>1?1:v; }
    applyMeta(ch, j);
    feedSpectrum(ch, mags);
  } catch(e){ /* réseau/JSON KO → on garde la démo */ }
}
const LIVE_MS = 150;                         // ~6.7 trames/s par canal
setInterval(() => { pollPsd('ms'); pollPsd('bts'); }, LIVE_MS);
pollPsd('ms'); pollPsd('bts');

/* ---- barre de reglages : lit /fftcfg, pousse les changements ------------- */
(function(){
  var pal=document.getElementById('c-pal'), dr=document.getElementById('c-dr'),
      drv=document.getElementById('c-drv'), zm=document.getElementById('c-zoom'),
      dir=document.getElementById('c-dir'), flip=document.getElementById('c-flip');
  if(!pal) return;
  function paint(c){
    if(!c) return;
    if(pal.options.length===0 && c.palettes)
      c.palettes.forEach(function(p){ var o=document.createElement('option');
        o.value=p; o.textContent=p; pal.appendChild(o); });
    pal.value=c.palette; dr.value=c.dr; drv.textContent=c.dr; zm.value=String(c.zoom||1);
    dir.textContent = (c.wfdir==='up') ? 'cascade ↑' : 'cascade ↓';
    dir.dataset.dir = c.wfdir||'down';
    if(flip){ flip.textContent = c.flip ? 'spectre ↓' : 'spectre ↑';
              flip.dataset.flip = c.flip ? '1' : '0'; }
  }
  function push(q){ fetch('/fftcfg?'+q,{cache:'no-store'})
      .then(function(r){return r.json();}).then(paint).catch(function(){}); }
  fetch('/fftcfg',{cache:'no-store'}).then(function(r){return r.json();}).then(paint).catch(function(){});
  pal.onchange=function(){ push('palette='+encodeURIComponent(pal.value)); };
  zm.onchange =function(){ push('zoom='+encodeURIComponent(zm.value)); };
  dr.oninput  =function(){ drv.textContent=dr.value; };
  dr.onchange =function(){ push('dr='+encodeURIComponent(dr.value)); };
  dir.onclick =function(){ push('dir='+(dir.dataset.dir==='up'?'down':'up')); };
  if(flip) flip.onclick=function(){ push('flip='+(flip.dataset.flip==='1'?'0':'1')); };
})();
</script>
</body>
</html>
